diag_log "[INIT] Forcing reload of CTI_CO_FNC_GetMagazineInfo...";

// Принудительно удаляем старую версию
CTI_CO_FNC_GetMagazineInfo = nil;

// Загружаем новую версию
call compile preprocessFileLineNumbers "Common\Functions\Common_GetMagazineInfo.sqf";

if (isNil "CTI_CO_FNC_GetMagazineInfo") then {
    diag_log "[INIT ERROR] CTI_CO_FNC_GetMagazineInfo failed to load! Creating stub...";
    
    CTI_CO_FNC_GetMagazineInfo = {
        params ["_magazineClass", "_data"];
        private _total = 32;
        private _current = 32;
        private _flightTime = 20;
        private _dispersion = 25;
        private _reloadTime = 10;
        
        if (_magazineClass find "155mm" != -1) then {
            _flightTime = 30; _dispersion = 25; _reloadTime = 10;
        } else {
            if (_magazineClass find "82mm" != -1) then {
                _flightTime = 12; _dispersion = 15; _reloadTime = 8;
            } else {
                if (_magazineClass find "230mm" != -1) then {
                    _flightTime = 20; _dispersion = 35; _reloadTime = 15;
                };
            };
        };
        
        if (count _data >= 3) then {
            _flightTime = _data select 0;
            _dispersion = _data select 1;
            _reloadTime = _data select 2;
        };
        
        [_current, _total, _flightTime, _dispersion, _reloadTime]
    };
    diag_log "[INIT] CTI_CO_FNC_GetMagazineInfo stub created";
} else {
    diag_log format ["[INIT] CTI_CO_FNC_GetMagazineInfo loaded: %1", CTI_CO_FNC_GetMagazineInfo];
};